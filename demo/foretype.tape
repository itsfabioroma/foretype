Type " "
Sleep 650ms
Type "b"
Sleep 73ms
Type "t"
Sleep 65ms
Type "w"
Sleep 58ms
Type ","
Sleep 78ms
Type " "
Sleep 158ms
Type "w"
Sleep 68ms
