Sleep 72ms
Type "c"
Sleep 54ms
Type "a"
Sleep 76ms
Type "l"
Sleep 144ms
Type "."
Sleep 70ms
Type " "
Sleep 650ms
Type "b"
Sleep 90ms
Type "t"
Sleep 42ms
Type "w"
Sleep 65ms
Type ","
Sleep 86ms
Type " "
Sleep 146ms
Type "w"
Sleep 99ms
Type "h"
Sleep 77ms
Type "o"
Sleep 80ms
Type " "
Sleep 147ms
Type "i"
Sleep 78ms
Type "s"
Sleep 30ms
Type " "
Sleep 197ms
Type "J"
Sleep 108ms
Type "o"
