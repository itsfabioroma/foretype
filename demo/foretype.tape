# One terminal, two panes, every keystroke sent to both at the same instant:
# plain ssh on top, foretype below. Typing follows a human rhythm (bursts within
# words, beats between them). Render with demo/render.sh, which sets up the panes.
Output demo/recording.gif

Set Shell "zsh"
Set FontSize 20
Set Width 1180
Set Height 360
Set Padding 16
Set Framerate 30
Set TypingSpeed 1ms
Set CursorBlink false
Set Theme "Catppuccin Mocha"

Hide
Type "tmux -L foretype-demo attach -t demo" Enter
Sleep 1500ms
Show

Sleep 500ms
Type "s"
Sleep 30ms
Type "s"
Sleep 43ms
Type "h"
Sleep 47ms
Type " "
Sleep 76ms
Type "d"
Sleep 35ms
Type "e"
Sleep 43ms
