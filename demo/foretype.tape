# One terminal, two panes, every keystroke sent to both at the same instant:
# foretype on top, plain ssh below. Typing follows a human rhythm (bursts within
# words, beats between them). Render with demo/render.sh, which sets up the panes.
Output demo/recording.gif

Set Shell "zsh"
Set FontSize 20
Set Width 1040
Set Height 360
Set Padding 16
Set Framerate 30
Set TypingSpeed 1ms
Set CursorBlink false
Set Theme "Catppuccin Mocha"

Hide
Type "tmux -L foretype-demo attach -t demo" Enter
Sleep 1500ms
Show

Sleep 500ms
Type "s"
Sleep 30ms
Type "s"
Sleep 43ms
Type "h"
Sleep 47ms
Type " "
Sleep 76ms
Type "d"
Sleep 35ms
Type "e"
Sleep 43ms
Type "v"
Sleep 35ms
Type "b"
Sleep 43ms
Type "o"
Sleep 31ms
Type "x"
Sleep 150ms
Enter
Sleep 1200ms
Type "#"
Sleep 45ms
Type " "
Sleep 169ms
Type "t"
Sleep 80ms
Type "h"
Sleep 30ms
Type "i"
Sleep 84ms
Type "s"
Sleep 86ms
Type " "
Sleep 170ms
Type "i"
Sleep 108ms
Type "s"
Sleep 45ms
Type " "
Sleep 122ms
Type "n"
Sleep 43ms
Type "o"
Sleep 60ms
Type "w"
Sleep 76ms
Type " "
Sleep 178ms
Type "i"
Sleep 84ms
Type "n"
Sleep 40ms
Type "s"
Sleep 132ms
Type "t"
Sleep 88ms
Type "a"
Sleep 103ms
Type "n"
Sleep 64ms
Type "t"
Sleep 62ms
Type "."
Sleep 63ms
Type " "
Sleep 480ms
Type "r"
Sleep 98ms
Type "e"
Sleep 74ms
Type "m"
Sleep 85ms
Type "o"
Sleep 77ms
Type "t"
Sleep 72ms
Type "e"
Sleep 77ms
Type " "
Sleep 169ms
Type "m"
Sleep 58ms
Type "a"
Sleep 98ms
Type "d"
Sleep 77ms
Type "e"
Sleep 87ms
Type " "
Sleep 147ms
Type "l"
Sleep 39ms
