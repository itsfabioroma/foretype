# One terminal, two panes, every keystroke sent to both at the same instant:
# plain ssh on top, foretype below. Typing follows a human rhythm (bursts within
# words, beats between them). Render with demo/render.sh, which sets up the panes.
Output demo/recording.gif

Set Shell "zsh"
Set FontSize 22
Set Width 900
Set Height 380
Set Padding 16
Set Framerate 30
Set TypingSpeed 1ms
Set CursorBlink false
Set Theme "Catppuccin Mocha"

Hide
Type "tmux -L foretype-demo attach -t demo" Enter
Sleep 1500ms
Show

Sleep 700ms
Type "s"
Sleep 67ms
Type "s"
Sleep 96ms
Type "h"
Sleep 107ms
Type " "
Sleep 192ms
Type "d"
Sleep 80ms
Type "e"
Sleep 97ms
Type "v"
Sleep 80ms
Type "b"
Sleep 96ms
Type "o"
Sleep 70ms
Type "x"
Sleep 350ms
Enter
Sleep 1800ms
Type "e"
Sleep 61ms
Type "c"
Sleep 62ms
Type "h"
Sleep 60ms
Type "o"
Sleep 76ms
Type " "
Sleep 178ms
Type '"'
Sleep 84ms
Type "r"
Sleep 40ms
Type "e"
Sleep 132ms
Type "m"
Sleep 88ms
Type "o"
Sleep 103ms
Type "t"
Sleep 64ms
Type "e"
Sleep 62ms
Type " "
Sleep 111ms
Type "m"
Sleep 63ms
Type "a"
Sleep 75ms
Type "d"
Sleep 65ms
Type "e"
Sleep 116ms
Type " "
Sleep 186ms
Type "l"
Sleep 82ms
Type "o"
Sleep 96ms
Type "c"
Sleep 76ms
Type "a"
Sleep 38ms
Type "l"
Sleep 87ms
Type ","
Sleep 40ms
Type " "
Sleep 480ms
Type "n"
Sleep 68ms
Type "o"
Sleep 39ms
Type " "
Sleep 168ms
Type "m"
Sleep 72ms
Type "o"
Sleep 59ms
Type "r"
Sleep 53ms
Type "e"
Sleep 38ms
Type " "
Sleep 120ms
Type "t"
Sleep 55ms
Type "y"
Sleep 66ms
Type "p"
Sleep 53ms
Type "i"
Sleep 74ms
Type "n"
Sleep 90ms
Type "g"
Sleep 105ms
Type " "
Sleep 161ms
Type "l"
Sleep 88ms
Type "a"
Sleep 86ms
Type "g"
Sleep 200ms
Type '"'
Sleep 900ms
Enter
Sleep 3s
