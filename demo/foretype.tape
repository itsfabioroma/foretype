Sleep 40ms
Type "e"
Sleep 132ms
Type "m"
Sleep 88ms
Type "o"
Sleep 103ms
Type "t"
Sleep 64ms
Type "e"
Sleep 62ms
Type " "
Sleep 111ms
Type "m"
Sleep 63ms
